---
import publications from '../../data/publications';import Publication from '../Publication.astro';
const {lang}=Astro.props;const pt=lang==='pt';
const topics=['All','PM','PN','EFT','Radiation','Modified gravity','Exact solutions'];const labels=pt?['Todos','PM','PN','EFT','Radiação','Gravidade modificada','Soluções exatas']:['All','PM','PN','EFT','Radiation','Modified gravity','Exact solutions'];
---
<header class="page-intro"><div class="eyebrow">{pt?'Artigos e outros trabalhos':'Papers & other work'}</div><h1>{pt?'Publicações':'Publications'}</h1><p class="lead">{pt?'Resultados em dinâmica de binárias compactas, radiação gravitacional, teorias de campos efetivas e soluções exatas.':'Work on compact-binary dynamics, gravitational radiation, effective field theory and exact solutions.'}</p></header>
<section class="page-section"><h2>{pt?'Publicações selecionadas':'Selected publications'}</h2>{publications.filter(p=>p.selected).map(p=><Publication p={p} lang={lang} anchor={false}/>)}</section>
<section id="all-publications" class="page-section"><h2>{pt?'Todos os artigos':'All papers'}</h2><div class="filter-bar" role="group" hidden aria-label={pt?'Filtrar por tema':'Filter by topic'}>{topics.map((t,i)=><button type="button" data-filter={t} aria-pressed={i===0?'true':'false'}>{labels[i]}</button>)}</div><p class="publication-count" aria-live="polite" data-count data-label={pt?'artigos':'papers'}>{publications.length} {pt?'artigos':'papers'}</p>{['preprint','published'].map(status=><div data-pub-group><h3 class="subheading">{status==='preprint'?(pt?'Pré-publicações':'Preprints'):(pt?'Artigos publicados':'Journal articles')}</h3>{publications.filter(p=>p.status===status).map(p=><Publication p={p} lang={lang} heading="h4"/>)}</div>)}</section>
<section class="page-section"><h2>{pt?'Teses, livro e material didático':'Theses, book & teaching material'}</h2><ul class="resource-list"><li><a href="https://arxiv.org/abs/2309.00772">Classical amplitudes in gravitational-wave physics</a><br/><span class="muted">{pt?'Tese de doutorado · UFRN · 2023':'PhD thesis · UFRN · 2023'}</span></li><li><em>On symmetries of exact solutions of Einstein field equations</em><br/><span class="muted">{pt?'Dissertação de mestrado · UFPE · 2019':'MSc thesis · UFPE · 2019'}</span></li><li><em>Symmetries and exact solutions in general relativity: The role of symmetries in the attainment of exact solutions of Einstein Field Equations</em><br/><span class="muted">LAMBERT Academic Publishing · 2019 · ISBN 978-6-200-48020-0</span></li><li><a href="https://drive.google.com/file/d/11dObSsb8KzH4LvOPk5Aiz79uG4NsSRC_/view?usp=sharing">Tutorial do LaTeX</a><br/><span class="muted">{pt?'Tutorial introdutório em português':'Introductory tutorial in Portuguese'}</span></li></ul></section>
<script>
 const container=document.querySelector('#all-publications');const bar=container?.querySelector<HTMLElement>('.filter-bar');if(bar)bar.hidden=false;
 const buttons=container?.querySelectorAll<HTMLButtonElement>('[data-filter]');const items=container?.querySelectorAll<HTMLElement>('.publication');
 const filter=(topic:string)=>{let count=0;items?.forEach(item=>{const show=topic==='All'||item.dataset.topics?.split('|').includes(topic);item.hidden=!show;if(show)count++});buttons?.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===topic)));container?.querySelectorAll<HTMLElement>('[data-pub-group]').forEach(g=>g.hidden=![...g.querySelectorAll<HTMLElement>('.publication')].some(p=>!p.hidden));const label=container?.querySelector<HTMLElement>('[data-count]');if(label)label.textContent=`${count} ${label.dataset.label}`;};
 buttons?.forEach(b=>b.addEventListener('click',()=>filter(b.dataset.filter!)));window.addEventListener('hashchange',()=>{filter('All');document.getElementById(location.hash.slice(1))?.scrollIntoView()});
</script>
