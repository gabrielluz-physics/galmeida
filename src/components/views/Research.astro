---
import {research} from '../../data/research';import publications from '../../data/publications';import {path,type Lang} from '../../data/site';import Scattering from '../Scattering.astro';
const {lang}=Astro.props;const l=lang as Lang;const pt=l==='pt';
---
<header class="page-intro"><div class="eyebrow">{pt?'Programa de pesquisa':'Research program'}</div><h1>{pt?'Dinâmica, radiação e gravidade':'Dynamics, radiation & gravity'}</h1><p class="lead">{pt?'Métodos analíticos para compreender a interação de objetos compactos e os sinais gravitacionais que produzem.':'Analytic methods to understand the interaction of compact objects and the gravitational signals they produce.'}</p></header>
<div class="research-layout"><nav class="local-nav" aria-label={pt?'Tópicos de pesquisa':'Research topics'}>{research.map(r=><a href={`#${r.id}`}>{r.number} · {r[l].title}</a>)}</nav><div>{research.map(r=><section id={r.id} class="research-topic"><span class="number">{r.number}</span><h2>{r[l].title}</h2><p class="question">{r[l].question}</p><p>{r[l].body}</p><p>{r[l].method}</p>{r.id==='pm-scattering'&&<Scattering lang={l}/>}<div class="related"><strong>{pt?'Trabalhos relacionados':'Related work'}</strong><ul>{r.papers.map(id=>{const p=publications.find(p=>p.id===id)!;return <li><a lang="en" href={`${path(l,'publications')}#${id}`}>{p.title}</a> <span class="muted">({p.year})</span></li>})}</ul></div></section>)}</div></div>
