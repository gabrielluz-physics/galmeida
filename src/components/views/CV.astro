---
import {timeline,awards,talks,visits,teaching,assistantTeaching} from '../../data/academic';import {bios,path,asset,formatAcademicDate,type Lang} from '../../data/site';
const {lang}=Astro.props;const l=lang as Lang;const pt=l==='pt';
---
<header class="page-intro"><div class="eyebrow">Curriculum vitae</div><h1>{pt?'Currículo acadêmico':'Academic CV'}</h1><p class="lead">{bios[l].short}</p><div class="actions"><a class="button primary" href={asset(`documents/Gabriel-Luz-Almeida-CV-${l}.pdf`)} download>{pt?'Baixar currículo (PDF)':'Download CV (PDF)'}</a></div></header>
<section class="page-section"><h2>{pt?'Posições acadêmicas e formação':'Appointments & education'}</h2>{timeline.map(t=><div class="timeline-item"><span class="date">{formatAcademicDate(t.date,l)}</span><div><h3>{t.place}</h3><p>{t[l]}</p>{t.detail&&<p class="detail">{pt?'Orientação / supervisão':'Advisor / supervisor'}: {t.detail}</p>}</div></div>)}</section>
<section class="page-section"><h2>{pt?'Prêmios':'Awards'}</h2>{awards.map(a=><p>{a.year} · {a[l]}</p>)}</section>
<section class="page-section"><h2>{pt?'Publicações':'Publications'}</h2><p><a href={path(l,'publications')}>{pt?'Artigos publicados, pré-publicações, teses e livro':'Journal articles, preprints, theses and book'}</a></p></section>
<section class="page-section"><h2>{pt?'Ensino':'Teaching'}</h2>{teaching.map(t=><p><strong>{t.title}</strong><br/><span class="muted">{t.place} · {formatAcademicDate(t.year,l)}</span></p>)}<p>{pt?'Estágios de docência e monitorias':'Teaching assistantships'}: {assistantTeaching.map(t=>`${t[l]} (${t.place}, ${formatAcademicDate(t.year,l)})`).join('; ')}.</p><p><a href={path(l,'teaching')}>{pt?'Atividades e abordagem de ensino':'Teaching activities & approach'}</a></p></section>
<section class="page-section"><h2>{pt?'Palestras selecionadas':'Selected talks'}</h2>{talks.map(t=><div class="timeline-item"><time class="date" datetime={t.date}>{formatAcademicDate(t.date,l)}</time><div><h3>{t.url?<a href={t.url}>{t.title}</a>:t.title}</h3><p class="muted">{t.place}</p></div></div>)}</section>
<section class="page-section"><h2>{pt?'Visitas de pesquisa':'Research visits'}</h2>{visits.map(t=><div class="timeline-item"><span class="date">{formatAcademicDate(t.date,l)}</span><div><h3>{t.place}</h3><p>{t[l]}</p></div></div>)}</section>
