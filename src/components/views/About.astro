---
import {bios,asset,type Lang} from '../../data/site';import {timeline,awards} from '../../data/academic';
const {lang}=Astro.props;const l=lang as Lang;const pt=l==='pt';
---
<header class="page-intro"><div class="eyebrow">{pt?'Trajetória acadêmica':'Academic background'}</div><h1>{pt?'Sobre mim':'About me'}</h1></header><div class="bio-grid"><div><p class="lead">{bios[l].medium}</p><p>{bios[l].narrative}</p><p>{pt?'Atuo também como parecerista de Physical Review D e Physical Review Letters. Minha experiência de ensino inclui disciplinas de graduação no Brasil e cursos de ondas gravitacionais e EFT na China.':'I also serve as a referee for Physical Review D and Physical Review Letters. My teaching experience includes undergraduate physics in Brazil and courses on gravitational waves and EFT in China.'}</p></div><aside><img src={asset('images/portrait.webp')} alt="Gabriel Luz Almeida" width="1400" height="1400" loading="lazy"/></aside></div>
<section class="page-section" style="margin-top:45px"><h2>{pt?'Formação e posições acadêmicas':'Education & appointments'}</h2><div class="timeline">{timeline.map(t=><div class="timeline-item"><div class="date">{t.date}</div><div><h3>{t.place}</h3><p>{t[l]}</p>{t.detail&&<p class="detail">{pt?'Orientação / supervisão':'Advisor / supervisor'}: {t.detail}</p>}</div></div>)}</div></section>
<section class="page-section"><h2>{pt?'Prêmios e distinções':'Awards & distinctions'}</h2>{awards.map(a=><div class="award"><strong>{a.year}</strong><p>{a.url?<a href={a.url}>{a[l]}</a>:a[l]}</p></div>)}</section>
