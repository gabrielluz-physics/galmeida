---
import {aboutNarrative,asset,type Lang} from '../../data/site';import {timeline,awards} from '../../data/academic';
const {lang}=Astro.props;const l=lang as Lang;const pt=l==='pt';
---
<header class="page-intro"><div class="eyebrow">{pt?'Trajetória acadêmica':'Academic background'}</div><h1>{pt?'Sobre mim':'About me'}</h1></header><div class="bio-grid"><div>{aboutNarrative[l].map((paragraph,i)=><p class:list={{lead:i===0}}>{paragraph}</p>)}</div><aside><img src={asset('images/portrait.webp')} alt="Gabriel Luz Almeida" width="1400" height="1400" loading="lazy"/></aside></div>
<section class="page-section" style="margin-top:45px"><h2>{pt?'Formação e posições acadêmicas':'Education & appointments'}</h2><div class="timeline">{timeline.map(t=><div class="timeline-item"><div class="date">{t.date}</div><div><h3>{t.place}</h3><p>{t[l]}</p>{t.detail&&<p class="detail">{pt?'Orientação / supervisão':'Advisor / supervisor'}: {t.detail}</p>}</div></div>)}</div></section>
<section class="page-section"><h2>{pt?'Prêmios e distinções':'Awards & distinctions'}</h2>{awards.map(a=><div class="award"><strong>{a.year}</strong><p>{'url' in a&&a.url?<a href={a.url}>{a[l]}</a>:a[l]}</p>{'institution' in a&&<p class="muted">{a.institution[l]}</p>}{'description' in a&&<p>{a.description[l]}</p>}</div>)}</section>
