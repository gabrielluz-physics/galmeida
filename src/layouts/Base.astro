---
import '../styles/global.css';
import {site, nav, path, asset, bios, type Lang} from '../data/site';
import Profiles from '../components/Profiles.astro';
const {lang='en',page='',title,description=bios[lang as Lang].short,alternatePage=page}=Astro.props;
const l=lang as Lang;
const absolute=(p:string)=>Astro.site ? new URL(p,Astro.site).href : undefined;
const canonical=absolute(Astro.url.pathname);
const mainNav=['research','publications','teaching','digest','about','cv','photos'];
const schema={'@context':'https://schema.org','@type':'Person',name:site.name,jobTitle:bios[l].role,worksFor:{'@type':'CollegeOrUniversity',name:site.institution},sameAs:site.profiles.map(p=>p.url),...(canonical?{url:absolute(path(l))}:{})};
---
<!doctype html>
<html lang={l==='pt'?'pt-BR':'en'}>
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{title ? `${title} · ${site.name}` : `${site.name} · ${l==='pt'?'Física teórica':'Theoretical Physics'}`}</title>
 <meta name="description" content={description}/><meta name="author" content={site.name}/>
 {canonical&&<link rel="canonical" href={canonical}/>}
 {Astro.site&&<><link rel="alternate" hreflang="en" href={absolute(path('en',alternatePage))}/><link rel="alternate" hreflang="pt-BR" href={absolute(path('pt',alternatePage))}/><link rel="alternate" hreflang="x-default" href={absolute(path('en',alternatePage))}/></>}
 <meta property="og:title" content={title ? `${title} · ${site.name}`:site.name}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:locale" content={l==='pt'?'pt_BR':'en_US'}/>
 <meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title?`${title} · ${site.name}`:site.name}/><meta name="twitter:description" content={description}/>
 <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')}/><meta name="color-scheme" content="light dark"/>
 <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
 <script is:inline>try{const t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t;}catch{}</script>
</head>
<body>
 <a href="#main" class="skip-link">{l==='pt'?'Pular para o conteúdo':'Skip to content'}</a>
 <header class="site-header wrap">
  <div class="masthead"><a class="wordmark" href={path(l)}>Gabriel Luz Almeida<span>{l==='pt'?'Física teórica':'Theoretical physics'}</span></a>
   <div class="utilities"><div class="languages" role="group" aria-label={l==='pt'?'Idioma':'Language'}><a lang="en" href={path('en',alternatePage)} aria-current={l==='en'?'true':undefined}>EN</a><span aria-hidden="true">/</span><a lang="pt-BR" href={path('pt',alternatePage)} aria-current={l==='pt'?'true':undefined}>PT</a></div>
   <button class="theme-toggle" type="button" aria-label={l==='pt'?'Tema escuro':'Dark theme'} aria-pressed="false" title={l==='pt'?'Alternar tema':'Toggle theme'}><svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg></button>
   <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu</button></div>
  </div>
  <nav id="main-nav" aria-label={l==='pt'?'Navegação principal':'Main navigation'}>{mainNav.map(p=><a href={path(l,p)} aria-current={page===p?'page':undefined}>{nav[l][p]}</a>)}<a class="contact-nav" href={path(l,'contact')} aria-current={page==='contact'?'page':undefined}>{nav[l].contact}</a></nav>
 </header>
 <main id="main" class="wrap" tabindex="-1"><slot/></main>
 <footer class="site-footer wrap"><div><a class="footer-name" href={path(l)}>{site.name}</a><p>{site.center}<br/>{site.institution} · {bios[l].location}</p></div><div><Profiles/><a href={`mailto:${site.email}`}>{site.email}</a><p class="copyright">© {new Date().getFullYear()} {site.name}</p></div></footer>
 <script>
  const toggle=document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root=document.documentElement;
  const preference=matchMedia('(prefers-color-scheme: dark)');
  const isDark=()=>root.dataset.theme ? root.dataset.theme==='dark' : preference.matches;
  const syncTheme=()=>toggle?.setAttribute('aria-pressed',String(isDark()));
  syncTheme();preference.addEventListener('change',syncTheme);
  toggle?.addEventListener('click',()=>{root.dataset.theme=isDark()?'light':'dark';syncTheme();try{localStorage.setItem('theme',root.dataset.theme)}catch{}});
  const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');const header=document.querySelector('.site-header');
  menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));header?.classList.toggle('nav-open',!open)});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu?.getAttribute('aria-expanded')==='true'){menu.setAttribute('aria-expanded','false');header?.classList.remove('nav-open');menu.focus()}});
  document.documentElement.classList.add('js');
 </script>
</body>
</html>
