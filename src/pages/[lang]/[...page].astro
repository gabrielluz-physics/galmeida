---
import Base from '../../layouts/Base.astro';import {site,languages,pages,nav,bios,type Lang} from '../../data/site';
import Home from '../../components/views/Home.astro';import Research from '../../components/views/Research.astro';import Publications from '../../components/views/Publications.astro';import Teaching from '../../components/views/Teaching.astro';import About from '../../components/views/About.astro';import CV from '../../components/views/CV.astro';import Photos from '../../components/views/Photos.astro';import Contact from '../../components/views/Contact.astro';import Digest from '../../components/views/Digest.astro';
export function getStaticPaths(){return languages.flatMap(lang=>[undefined,...pages].map(page=>({params:{lang,page}})))}
const lang=Astro.params.lang as Lang;const page=Astro.params.page||'';const views={'':Home,research:Research,publications:Publications,teaching:Teaching,about:About,cv:CV,photos:Photos,contact:Contact,digest:Digest};const View=views[page as keyof typeof views];
const descriptions:Record<string,Record<Lang,string>>={research:{en:'Research on relativistic two-body dynamics, gravitational radiation, effective field theory and modified gravity.',pt:'Pesquisa em dinâmica relativística de dois corpos, radiação gravitacional, teorias de campos efetivas e gravidade modificada.'},publications:{en:'Publications, preprints and theses by Gabriel Luz Almeida, with arXiv, DOI and INSPIRE links.',pt:'Publicações, pré-publicações e teses de Gabriel Luz Almeida, com links arXiv, DOI e INSPIRE.'},teaching:{en:'Courses on gravitational waves and NRGR, minicourses and previous teaching experience.',pt:'Cursos de ondas gravitacionais e NRGR, minicursos e experiência anterior de ensino.'},digest:{en:'Weekly theoretical physics reading: gravitation, PN/PM, EFT, amplitudes and multiloop methods.',pt:'Leituras semanais de física teórica: gravitação, PN/PM, EFT, amplitudes e métodos multiloop.'},about:{en:bios.en.medium,pt:bios.pt.medium},cv:{en:'Academic CV: appointments, education, awards, teaching, talks and research visits.',pt:'Currículo acadêmico: posições, formação, prêmios, ensino, palestras e visitas de pesquisa.'},photos:{en:'Photographs of academic meetings, visits and milestones in physics.',pt:'Fotografias de encontros acadêmicos, visitas e momentos da trajetória na física.'},contact:{en:`Academic contact and public research profiles of ${site.name} at ${site.institution}.`,pt:`Contato acadêmico e perfis públicos de ${site.name} na ${site.institution}.`}};
---
<Base lang={lang} page={page} title={page?nav[lang][page]:undefined} description={descriptions[page]?.[lang]||bios[lang].short}><View lang={lang}/></Base>
